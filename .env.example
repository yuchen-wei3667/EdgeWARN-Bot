OUTPUT_DIR=output
SERVER_HOST=0.0.0.0
SERVER_PORT=6767
GEOCODING_API=https://geocoding-api.open-meteo.com

# Website whose dashboard the forecast image screenshots, and the Chromium that loads it.
# WEBSITE_URL=https://edgewarn.ashk3000.com
# CHROME_PATH=/usr/bin/chromium

# Instagram publishing (Instagram Login, needs the instagram_business_content_publish permission).
# PUBLIC_BASE_URL is the HTTPS address Instagram can reach this server at, such as a tunnel or domain.
# IG_ACCESS_TOKEN=
# IG_USER_ID=
# PUBLIC_BASE_URL=https://example.com

# Daily Instagram post: `npm run daily` posts the website's /automation/daily card to the feed every morning.
# DAILY_PLACE=Oklahoma City, OK
# DAILY_TIMEZONE=America/Chicago
# DAILY_HOUR=7
# DAILY_CAPTION=
