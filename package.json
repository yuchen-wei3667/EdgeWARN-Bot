{
  "name": "edgewarn-bot",
  "version": "0.1.0",
  "description": "EdgeWARN alert renderer with EWMRS overlays",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/backend/cli.ts",
    "start": "node dist/backend/cli.js",
    "forecast": "tsx src/backend/forecast/cli.ts",
    "forecast:start": "node dist/backend/forecast/cli.js",
    "server:dev": "tsx src/backend/server.ts",
    "server:start": "node dist/backend/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
