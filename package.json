{
  "name": "edgewarn-bot",
  "version": "0.1.0",
  "description": "EdgeWARN daily forecast image generator",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "forecast": "tsx src/backend/forecast/cli.ts",
    "daily": "tsx src/backend/main_loop/cli.ts",
    "daily:start": "node dist/backend/main_loop/cli.js",
    "ig": "tsx src/connectors/ig/cli.ts",
    "ig:start": "node dist/connectors/ig/cli.js",
    "forecast:start": "node dist/backend/forecast/cli.js",
    "server:dev": "tsx src/backend/server.ts",
    "server:start": "node dist/backend/server.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "puppeteer-core": "^25.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
